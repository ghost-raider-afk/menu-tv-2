# Независимая конфигурация ТВ МЕНЮ.
# Создаётся автоматически скриптом menu-tv-2.sh при установке.

# Начальное название приложения для первой установки. Затем его можно изменить
# в разделе «Настройки сайта» без изменения секретов и системных параметров.
APP_NAME=ТВ МЕНЮ
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# Публичный HTTPS-домен запрашивается установщиком.
MENU_TV_2_DOMAIN=

# Телевизоры используют SFTP через CX Проводник. Применяется тот же домен,
# но у SFTP собственный TCP-порт, он не проходит через HTTPS.
SFTP_PUBLIC_HOST=
SFTP_PORT=2022
SFTP_API_URL=http://sftp:8080
SFTP_STORAGE_ROOT=/srv/menu-tv-sftp
# Внутренние служебные данные — не передавайте их телевизорам.
SFTP_ADMIN_USERNAME=menu_tv_2_service
SFTP_ADMIN_PASSWORD=replace-with-generated-sftp-admin-password
GENERATED_PASSWORD_LENGTH=10

# Данные только для собственной базы PostgreSQL этого приложения.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=menu_tv_2
POSTGRES_USER=menu_tv_2
POSTGRES_PASSWORD=replace-with-generated-database-password

# Начальная учётная запись создаётся только при пустой базе, после успешного
# запуска переносится в PostgreSQL и эти строки удаляются установщиком.
# Для ручного первого запуска задайте оба значения. В дальнейшем пароль меняется
# только в разделе «Настройки пользователя» и хранится в БД в виде хеша.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=32

# Настройки безопасности сессии и ограничения входа задаются только здесь.
SESSION_SECRET=replace-with-generated-session-secret
SESSION_TTL_HOURS=12
SECURE_COOKIES=true
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
LOGIN_LIMITER_MAX_ENTRIES=500

# Лимиты HTTP и данных редактора.
JSON_BODY_MAX_BYTES=65536
MENU_DRAFT_MAX_BYTES=49152
SCREEN_SOURCE_MAX_BYTES=12582912

# Допустимый диапазон обновления панели и максимальный размер ТВ-макета.
DASHBOARD_REFRESH_MIN_SECONDS=15
DASHBOARD_REFRESH_MAX_SECONDS=300
SCREEN_MAX_WIDTH=1920
SCREEN_MAX_HEIGHT=1080

# Хранилище и лимиты оформления сайта/шаблонов. Загрузка доступна только администратору.
SITE_ASSETS_ROOT=/srv/menu-tv-site-assets
SITE_LOGO_MAX_BYTES=2097152
SITE_FAVICON_MAX_BYTES=524288
TEMPLATE_BACKGROUND_MAX_BYTES=12582912

# Устанавливайте true только для пустого демонстрационного развёртывания.
SEED_DEMO_DATA=false
