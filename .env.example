# Independent Menu TV 2.0 configuration.
# Created automatically by menu-tv-2.sh during installation.

APP_NAME=Menu TV 2.0
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# The public HTTPS domain is requested by the installer.
MENU_TV_2_DOMAIN=

# SFTP is used by the TVs through CX File Explorer. The same domain is used,
# but SFTP has its own TCP port and is not routed through HTTPS.
SFTP_PUBLIC_HOST=
SFTP_PORT=2022
SFTP_API_URL=http://sftp:8080
SFTP_STORAGE_ROOT=/srv/menu-tv-sftp
# Internal service credentials — never give these to a TV.
SFTP_ADMIN_USERNAME=menu_tv_2_service
SFTP_ADMIN_PASSWORD=replace-with-generated-sftp-admin-password

# Credentials for this application's own PostgreSQL instance only.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=menu_tv_2
POSTGRES_USER=menu_tv_2
POSTGRES_PASSWORD=replace-with-generated-database-password

# The only administrator of this independent application.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-generated-admin-password

# Session security is controlled only from this file.
SESSION_SECRET=replace-with-generated-session-secret
SESSION_TTL_HOURS=12
SECURE_COOKIES=true

# Set true only for an empty disposable demonstration deployment.
SEED_DEMO_DATA=false
