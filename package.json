{
  "name": "menu-tv-2",
  "version": "1.3.2",
  "private": true,
  "description": "Independent Menu TV 2.0 administration application",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "find src -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "start": "node src/server.js",
    "test": "node --test",
    "test:browser": "playwright test",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.13.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "pg-mem": "^3.0.5"
  }
}
